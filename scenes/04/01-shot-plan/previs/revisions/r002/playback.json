    {
      "id": "mehmed-start",
      "startFrame": 0,
      "text": "Mehmed studies the drawing as he begins his circuit.",
      "kind": "action",
      "subject": "mehmed-ii"
    },
    {
      "id": "mehmed-across",
      "startFrame": 84,
      "text": "Mehmed stops opposite Urban and names the target.",
      "kind": "action",
      "subject": "mehmed-ii"
    },
    {
      "id": "line-1",
      "startFrame": 92,
      "text": "Can it break the walls of Constantinople?",
      "kind": "dialogue",
      "speaker": "mehmed-ii",
      "endFrame": 160
    },
    {
      "id": "line-2",
      "startFrame": 175,
      "text": "No cannon breaks a wall by itself. It breaks one stone. Then another. Then the sleep of the men repairing them.",
      "kind": "dialogue",
      "speaker": "urban",
      "endFrame": 353
    },
    {
      "id": "urban-explains",
      "startFrame": 180,
      "text": "Urban starts indicating successive points on the plan.",
      "kind": "action",
      "subject": "urban"
    },
    {
      "id": "mehmed-understands",
      "startFrame": 362,
      "text": "Mehmed lifts his gaze as he understands the weapon's purpose.",
      "kind": "action",
      "subject": "mehmed-ii"
    },
    {
      "id": "line-3",
      "startFrame": 373,
      "text": "So it is a weapon against time.",
      "kind": "dialogue",
      "speaker": "mehmed-ii",
      "endFrame": 428
    },
    {
      "id": "line-4",
      "startFrame": 443,
      "text": "Against time, pride, and mortar.",
      "kind": "dialogue",
      "speaker": "urban",
      "endFrame": 497
    },
    {
      "id": "mehmed-signal-onset",
      "startFrame": 506,
      "text": "Mehmed gives the scribe a small signal.",
      "kind": "action",
      "subject": "mehmed-ii"
    },
    {
      "id": "scribe-open-onset",
      "startFrame": 526,
      "text": "The scribe opens the chest and exposes the coins.",
      "kind": "action",
      "subject": "scribe"
    },
    {
      "id": "line-5",
      "startFrame": 596,
      "text": "You asked the Romans for a price. I will pay four.",
      "kind": "dialogue",
      "speaker": "mehmed-ii",
      "endFrame": 695
    },
    {
      "id": "line-6",
      "startFrame": 734,
      "text": "And the bronze?",
      "kind": "dialogue",
      "speaker": "urban",
      "endFrame": 767
    },
    {
      "id": "line-7",
      "startFrame": 806,
      "text": "My empire has bells enough to become thunder.",
      "kind": "dialogue",
      "speaker": "mehmed-ii",
      "endFrame": 901
    },
    {
      "id": "mara-watches",
      "startFrame": 919,
      "text": "Mara watches Urban's face for his answer.",
